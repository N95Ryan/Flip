PORT=8080
DATABASE_URL=
JWT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_LIFETIME=
STRIPE_WEBHOOK_SECRET=

# Webhook E2E tests only — Neon branch test-e2e (never production DATABASE_URL)
# Quote the value — Neon URLs often contain & (e.g. sslmode=require&channel_binding=require)
# Example: TEST_DATABASE_URL='postgresql://user:pass@ep-xxxx.neon.tech/neondb?sslmode=require'
TEST_DATABASE_URL=

# Local dev: filesystem avatars (default if S3_BUCKET empty)
AVATAR_UPLOAD_DIR=./uploads/avatars
AVATAR_PUBLIC_BASE_URL=http://localhost:8080

# Production on Render: use S3-compatible storage (R2, S3). Required for profile photos.
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=
