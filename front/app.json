{
  "expo": {
    "name": "Flip",
    "slug": "flip",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "flip",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flip.app"
    },
    "android": {
      "package": "com.flip.app",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Flip a besoin d'accéder à vos photos pour votre avatar.",
          "cameraPermission": "Flip a besoin d'accéder à la caméra pour votre avatar."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
