{
  "expo": {
    "name": "Flip",
    "slug": "flip",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "flip",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flip.app"
    },
    "android": {
      "package": "com.flip.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
